{
  "name": "irctc-cypress-automation",
  "version": "3.0.4",
  "description": "IRCTC Ticket Booking",
  "scripts": {
    "start-irctc-booking": "cypress run --headed --no-exit",
    "start-booking": "npm run validate-config && npm run start-irctc-booking",
    "test": "cypress run",
    "validate-config": "node scripts/validate-config.js",
    "validate-example": "node scripts/validate-config.js cypress/fixtures/passenger_data.example.json",
    "preflight": "npm run validate-example && npm run self-test",
    "plan-preview": "node scripts/plan-preview.js",
    "self-test": "node scripts/self-test.js",
    "next-attempt": "node scripts/next-attempt.js",
    "prepare-attempt": "node scripts/materialize-attempt.js"
  },
  "author": "Shivam Pandey",
  "license": "ISC",
  "dependencies": {
    "cypress": "13.7.1",
    "dayjs": "^1.11.10",
    "fs.promises": "^0.1.2",
    "wait-on": "^8.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
